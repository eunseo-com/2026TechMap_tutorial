@Tutorial(time: 25) {
    @Intro(title: "C3의 섬에서 먼저 숨기") {
        첫 장의 카메라는 iPhone의 카메라가 아닙니다. C3 섬을 바라보도록 코드에 둔 `SCNCamera`입니다. 돼지·나무·빛·카메라가 모두 개발자가 만든 SceneKit 장면 안에 있고, 화면을 돌리거나 돼지를 탭해도 현실의 물체는 이 세계에 들어오지 않습니다.

        이 장의 목표는 SceneKit이 나쁘다는 결론이 아닙니다. SceneKit이 개발자가 선언한 세계를 정확히 렌더링한다는 사실과, 그 세계에 아직 현실의 가구가 없다는 사실을 구분하는 것입니다.
    }

    @Section(title: "가상 카메라로 C3 섬 바라보기") {
        `SCNView`는 장면과 `pointOfView`를 받아 화면을 그립니다. 여기서 `pointOfView`는 장면 안의 `SCNCamera` 노드입니다. 기기 카메라 권한도 ARKit 세션도 아직 없습니다.

        @Steps {
            @Step {
                SceneKit 뷰를 만들고 C3 월드의 카메라 노드를 지정합니다.

                @Code(name: "C3ClosedWorldSceneView.swift", file: "01-C3ClosedWorld-07-01.swift")

                실행 확인: 섬이 보이지만, 실제 방의 바닥이나 소파는 영상 배경으로도 나오지 않습니다.
            }

            @Step {
                카메라 위치는 섬을 중심으로 도는 숫자와 `SCNLookAtConstraint`로 정합니다. 이 값은 현실 방을 측정한 결과가 아니라 개발자가 만든 궤도입니다.

                `SCNCamera`는 장면을 보는 눈일 뿐, 주변을 관찰하는 센서가 아닙니다.
            }
        }
    }

    @Section(title: "탭과 회전도 선언된 노드 안에서만 일어나기") {
        C3 장면의 탭은 화면 좌표에서 장면 안으로 광선을 보내는 `SCNView.hitTest`입니다. 결과로 받은 노드가 `EscapePig`의 자손인지 확인한 뒤에만 돼지를 움직입니다. 팬 제스처도 카메라 yaw만 바꿉니다.

        @Steps {
            @Step {
                탭과 팬 제스처의 역할을 코드로 나눕니다.

                @Code(name: "C3ClosedWorldSceneView+Input.swift", file: "01-C3ClosedWorld-07-02.swift")

                돼지를 탭하면 돼지는 `Cylinder_Tree`의 반대편으로 걷습니다. 나무와 돼지 모두 씬에 미리 추가된 노드이므로, 숨을 곳도 목적지도 코드가 알고 있습니다. 화면을 밀면 가상 카메라가 섬 주위를 돌지만, 이 동작은 현실 카메라를 켜거나 실제 가구를 탐색하지 않습니다.
            }

            @Step {
                나무 뒤 도착 뒤에는 놀란 포즈와 “아, 들켰네…” 자막이 이어집니다. 이 장면은 가짜 세계에서도 카메라 각도에 따라 가려짐이 달라질 수 있음을 보여 주지만, 가리는 나무 역시 앱 안의 모델입니다.
            }
        }
    }

    @Section(title: "이 세계에 없는 것은 클릭할 수도 없다") {
        @Steps {
            @Step {
                현실의 소파나 책상은 `SCNNode`가 아니므로 C3의 `hitTest` 결과가 될 수 없습니다. 가상 카메라를 아무리 회전해도 현실 물체의 위치·형태·앞뒤 관계는 이 장면에 들어오지 않습니다.

                다음 장에서는 같은 돼지가 시스템 카메라의 실제 영상과 공간 정보를 받을 준비를 합니다.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            이 장에서 화면을 밀어 카메라가 회전해도 현실 소파를 찾지 못하는 이유는 무엇인가요?

            @Choice(isCorrect: true) {
                회전하는 것은 SceneKit 장면 안의 `SCNCamera`이고, 현실 소파는 씬의 노드나 공간 입력이 아니기 때문입니다.

                @Justification {
                    `SCNView.hitTest`는 이미 장면에 있는 지오메트리를 찾습니다. 현실을 관찰해 메쉬나 앵커를 만들려면 다음 장의 AR 세션이 필요합니다.
                }
            }

            @Choice(isCorrect: false) {
                카메라가 충분히 많이 회전하면 SceneKit이 현실 소파를 자동으로 노드로 만들기 때문입니다.

                @Justification {
                    회전은 기존 카메라의 시점만 바꿉니다. 노드·메쉬·앵커를 새로 만들지 않습니다.
                }
            }
        }
    }
}
