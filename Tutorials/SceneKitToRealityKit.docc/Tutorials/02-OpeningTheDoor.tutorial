@Tutorial(time: 20) {
    @Intro(title: "기기 카메라로 문 열기") {
        C3의 `SCNCamera`는 코드로 만든 섬을 보는 가상 카메라였습니다. 이제 돼지가 현실로 나가기 위해서는 기기의 실제 카메라와 ARKit 세션이 필요합니다. 이 전환은 단순히 뷰를 바꾸는 일이 아니라, 좌표와 가려짐의 근거를 현실 공간에서 받기 시작하는 순간입니다.
    }

    @Section(title: "카메라 권한을 경험의 전환점으로 만들기") {
        C3에서 돼지가 들킨 뒤에만 시스템 카메라 권한을 요청합니다. 사용자가 거부하면 RealityKit 세션을 몰래 시작하지 않고, 설정에서 다시 허용할 수 있는 안내를 보여 줍니다.

        @Steps {
            @Step {
                현재 권한 상태가 이미 결정되어 있으면 그 결과를 바로 전달하고, 처음이라면 `AVCaptureDevice.requestAccess(for: .video)`를 호출합니다.

                @Code(name: "CameraAuthorizer.swift", file: "02-OpeningTheDoor-01-01.swift")

                실행 확인: 이때부터 기기 카메라 권한이 필요한 실제 공간 경험이 시작됩니다. Chapter 1의 가상 카메라에는 이 권한이 필요하지 않았습니다.
            }
        }
    }

    @Section(title: "ARView가 실제 화면을 얻은 뒤 세션 시작하기") {
        실기기에서 AR 카메라 배경이 검게 멈추지 않도록, 내부 `ARView`가 창에 붙고 유효한 크기를 받은 뒤에 한 번만 세션을 시작합니다. 이 처리는 에셋 문제가 아니라 뷰 수명과 세션 시작 순서의 문제를 분리해 확인한 결과입니다.

        @Steps {
            @Step {
                컨테이너의 `layoutSubviews`에서 내부 ARView의 frame을 정한 뒤 시작 조건을 검사합니다.

                @Code(name: "RealityARSessionContainer.swift", file: "02-OpeningTheDoor-02-01.swift")

                실행 확인: 지원 기기에서 카메라 배경이 보이면, 앱은 이제 메쉬와 바닥을 스캔할 준비가 된 것입니다. 아직 돼지는 아무 물체 뒤에도 숨지 않습니다.
            }
        }
    }

    @Section(title: "평면은 바닥의 후보를 알려 주고, 사용자는 숨을 물체를 고른다") {
        @Steps {
            @Step {
                이 구현은 단순히 아무 수평면에 `AnchorEntity(.plane(...))`를 붙이는 단계에서 멈추지 않습니다. 수평 바닥 평면은 돼지의 발을 놓을 높이를 알려 주고, 사용자가 다음 장에서 실제 물체의 수직 옆면을 탭해 숨을 장소를 선택합니다.

                다음 장에서 현실 메쉬가 드디어 돼지와 카메라 사이의 앞뒤 관계에 참여합니다.
            }
        }
    }
}
